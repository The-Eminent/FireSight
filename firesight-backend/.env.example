PORT=5001
PREDICTION_SERVICE_URL=http://127.0.0.1:8000
MONGODB_URI=mongodb://localhost:27017/firesight
NASA_API_KEY=
MAPBOX_ACCESS_TOKEN=
PYTHON_COMMAND=./ml/venv/bin/python

# Public Census endpoint; no API key is required.
CENSUS_URBAN_URL=https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/Urban/MapServer/8/query

# Optional curated GeoJSON FeatureCollection of known persistent heat sources.
# Each feature must be a Point with a stable id/sourceId property.
INDUSTRIAL_BLACKLIST_URL=

# Background detection refresh. The map API reads the last completed snapshot.
WILDFIRE_REFRESH_ENABLED=true
WILDFIRE_REFRESH_ON_START=true
WILDFIRE_REFRESH_INTERVAL_MINUTES=15
